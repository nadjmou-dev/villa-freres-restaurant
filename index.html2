    Se connecter
  </button>
</form>
    </div>

    <div class="dash-panel" id="dashPanel" style="display:none">
      <div class="dash-head">
        <strong>🍽️ Tableau de bord — Villa Frères</strong>
        <div style="display:flex;gap:10px;align-items:center">
          <div class="notif-wrap" id="notifWrap">
              <button class="notif-btn" id="notifBtn" type="button" aria-label="Notifications" title="Nouvelles réservations">🔔<span class="notif-count" id="notifCount">0</span></button>
              <div class="notif-menu" id="notifMenu">
                <div class="notif-title">Notifications</div>
                <div class="notif-list" id="notifList"></div>
              </div>
            </div>
            <button class="btn small-btn" id="logoutBtn" type="button">Déconnexion</button>
          <button class="dash-close" id="closeDash2" aria-label="Fermer">×</button>
