            <div class="two"><div><label for="mCat">Catégorie</label><select id="mCat"></select></div><div><label for="mAvail">Disponibilité</label><select id="mAvail"><option value="1">Disponible</option><option value="0">Indisponible</option></select></div></div>
            <div><label for="mDesc">Description</label><textarea id="mDesc" placeholder="Courte description du plat"></textarea></div>
            <div style="display:flex;gap:10px"><button class="btn primary" type="submit" id="menuSubmitBtn" style="flex:1">Ajouter au menu</button><button class="btn" type="button" id="menuCancelEdit" style="display:none">Annuler</button></div>
          </form>
          <div style="margin-top:20px" id="dashMenuList"></div>
        </div>

        <div class="dash-pane" data-pane="reservations" style="display:none">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:16px">
            <div style="color:var(--muted);font-size:13px">Réservations enregistrées sur cet appareil.</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn small-btn" type="button" id="addResManual">+ Ajouter manuellement</button><button class="btn small-btn" type="button" id="exportCsv">⬇ Export CSV</button></div>
          </div>
          <div class="manual-form" id="manualResForm">
            <div class="two"><div><label for="mrName">Nom</label><input id="mrName"></div><div><label for="mrPhone">Téléphone</label><input id="mrPhone"></div></div>
            <div class="two"><div><label for="mrDate">Date</label><input id="mrDate" type="date"></div><div><label for="mrTime">Heure</label><input id="mrTime" type="time"></div></div>
            <div class="two"><div><label for="mrPeople">Personnes</label><input id="mrPeople" type="number" min="1" value="2"></div><div><label for="mrNote">Note</label><input id="mrNote" placeholder="Optionnel"></div></div>
            <div style="display:flex;gap:8px;margin-top:4px"><button class="btn primary small-btn" type="button" id="mrSave">Enregistrer</button><button class="btn small-btn" type="button" id="mrCancel">Annuler</button></div>
          </div>
          <div id="dashResList"></div>
        </div>

        <div class="dash-pane" data-pane="settings" style="display:none">
          <form id="passForm" style="max-width:380px">
            <label for="newPass">Nouveau mot de passe</label>
            <input id="newPass" type="password" minlength="4" required>
            <button class="btn primary" type="submit" style="width:100%">Mettre à jour le mot de passe</button>
            <div id="passSaved" style="display:none;color:var(--success);font-size:12px">✅ Mot de passe mis à jour.</div>
          </form>
          <hr style="border:none;border-top:1px solid var(--line);margin:22px 0">
          <button class="btn" type="button" id="resetMenuBtn">↺ Réinitialiser le menu par défaut</button>
          <p style="color:var(--muted);font-size:12px;margin-top:18px;line-height:1.7">⚠️ Ce site est autonome (sans serveur) : le menu, les réservations et le mot de passe sont stockés localement dans ce navigateur. Videz le cache ou changez d'appareil et ces données ne suivront pas — pensez à exporter les réservations en CSV régulièrement.</p>
        </div>

      </div>
    </div>
  </div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    /* =========================================================================
       VILLA FRÈRES — script du site
       Sections : (1) Données & stockage local  (2) Rendu du menu public
       (3) Formulaire de réservation  (4) Espace propriétaire (auth + onglets)
       (5) Gestion du menu (CRUD)  (6) Gestion des réservations  (7) Init
       Stockage : localStorage (données persistantes par navigateur/appareil),
       sessionStorage (session de connexion à l'espace propriétaire).
       ========================================================================= */

    /* ---------- (1) Données par défaut & stockage ---------- */
    const CATEGORIES = [
      {value:'traditionnel', label:'Traditionnel'},
      {value:'grillades',    label:'Viandes'},
      {value:'sandwich',     label:'Sandwichs'},
      {value:'poisson',      label:'Poissons'},
      {value:'boisson',      label:'Boissons'},
      {value:'dessert',      label:'Desserts'}
    ];

    const DEFAULT_MENU = [
      {id:'d1', name:'Chakhchoukha', desc:"Plat traditionnel cité parmi les plats appréciés dans les avis.", price:'', cat:'traditionnel', available:true},
      {id:'d2', name:'Filet / viande', desc:"Des plats à base de viande sont fréquemment mentionnés.", price:'', cat:'grillades', available:true},
      {id:'d3', name:'BLT & sandwichs', desc:"La catégorie sandwichs apparaît dans les informations publiques.", price:'', cat:'sandwich', available:true},
      {id:'d4', name:'Cordon bleu', desc:"Plat cité parmi les préparations proposées.", price:'', cat:'grillades', available:true},
      {id:'d5', name:'Poissons', desc:"Poisson frit et plats de poisson figurent parmi les mets cités.", price:'', cat:'poisson', available:true},
      {id:'d6', name:'Soupes & accompagnements', desc:"Soupes et légumes grillés sont également mentionnés.", price:'', cat:'traditionnel', available:true}
    ];

    const STORAGE = { MENU:'vf_menu_items', RES:'vf_reservations' };
    const AUTH_KEY = 'vf_admin_auth';
    const PASS_KEY = 'vf_admin_pass';
    const DEFAULT_PASS = 'VillaFreres2026';

    function loadMenu(){ try{ const raw = localStorage.getItem(STORAGE.MENU); return raw ? JSON.parse(raw) : DEFAULT_MENU; }catch(e){ return DEFAULT_MENU; } }
    function saveMenu(items){ try{ localStorage.setItem(STORAGE.MENU, JSON.stringify(items)); }catch(e){} }
    function loadReservations(){ try{ const raw = localStorage.getItem(STORAGE.RES); return raw ? JSON.parse(raw) : []; }catch(e){ return []; } }
    function saveReservations(items){ try{ localStorage.setItem(STORAGE.RES, JSON.stringify(items)); }catch(e){} } 
    const SUPABASE_URL = "https://snjpptllgchtvzxaqnix.supabase.co";
const SUPABASE_KEY = "sb_publishable_AoTdNs0hJwTL5w-hmXPxTg_kfPWBtAy";

const supabaseClient = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);
    function getAdminPass(){ return localStorage.getItem(PASS_KEY) || DEFAULT_PASS; }
    function isAuthed(){ return sessionStorage.getItem(AUTH_KEY) === '1'; }
    function setAuthed(v){ if(v) sessionStorage.setItem(AUTH_KEY,'1'); else sessionStorage.removeItem(AUTH_KEY); }

    function escapeHtml(str){
      return String(str==null?'':str).replace(/[&<>"']/g, s=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
    }
    function catLabel(val){ const c = CATEGORIES.find(c=>c.value===val); return c ? c.label : val; }

    const toast = document.getElementById('toast');
    let toastTimer = null;
    function showToast(msg){
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(()=>toast.classList.remove('show'), 3500);
    }

    /* ---------- (2) Rendu du menu public ---------- */
    let currentFilter = 'all';

    function renderFilters(){
      const wrap = document.getElementById('filtersWrap');
      wrap.innerHTML = '<button class="filter active" data-filter="all" type="button">Tout</button>' +
        CATEGORIES.map(c=>`<button class="filter" data-filter="${c.value}" type="button">${escapeHtml(c.label)}</button>`).join('');
      wrap.querySelectorAll('.filter').forEach(btn=>btn.addEventListener('click', ()=>{
        wrap.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter;
        renderMenu();
      }));
    }

    function renderMenu(){
      const items = loadMenu().filter(it => it.available !== false && (currentFilter==='all' || it.cat===currentFilter));
      const grid = document.getElementById('menuGrid');
      if(!items.length){
        grid.innerHTML = '<div class="dash-empty" style="grid-column:1/-1">Aucun plat dans cette catégorie pour le moment.</div>';
        return;
      }
      grid.innerHTML = items.map(it => `
        <article class="dish" data-cat="${escapeHtml(it.cat)}">
          <div class="dish-info"><h3>${escapeHtml(it.name)}</h3><p>${escapeHtml(it.desc||'')}</p></div>
          <div class="price">${it.price ? escapeHtml(it.price) + ' DA' : 'Sur demande'}</div>
        </article>`).join('');
    }

    /* ---------- (3) Formulaire de réservation (client) ---------- */
    const reservationForm = document.getElementById('reservationForm');
    const resSuccess = document.getElementById('resSuccess');
    const waConfirmBtn = document.getElementById('waConfirmBtn');
reservationForm.addEventListener('submit', async e => {
  e.preventDefault();

  const name = document.getElementById('name').value.trim();
  const phone = document.getElementById('phone').value.trim();
  const people = document.getElementById('people').value;
  const date = document.getElementById('date').value;
  const time = document.getElementById('time').value;
  const message = document.getElementById('message').value.trim();

  const { error } = await supabaseClient
    .from('reservations')
    .insert({
      name: name,
      phone: phone,
      people: people,
      date: date,
      time: time,
      message: message,
      status: 'pending'
    });

  if (error) {
    console.error('Supabase error:', error);
    showToast('حدث خطأ أثناء تسجيل الحجز.');
    return;
  }

  reservationForm.reset();
  document.getElementById('time').value = '20:00';

  resSuccess.style.display = 'block';
  showToast('Réservation enregistrée avec succès.');
});

    /* ---------- (4) Espace propriétaire : ouverture, connexion, onglets ---------- */
    const dashOverlay = document.getElementById('dashOverlay');
    const loginCard = document.getElementById('loginCard');
    const dashPanel = document.getElementById('dashPanel');

    function openDashboard(){
      dashOverlay.classList.add('show');
      if(isAuthed()){ showPanel(); }
      else { loginCard.style.display='block'; dashPanel.style.display='none'; document.getElementById('adminPass').focus(); }
    }
    function closeDashboard(){ dashOverlay.classList.remove('show'); }
    function showPanel(){
      loginCard.style.display='none'; dashPanel.style.display='block';
      renderDashboardMenu(); renderDashboardReservations();
      startAdminNotifications();
      requestNotificationPermission();
    }

    document.getElementById('openDash').addEventListener('click', e=>{ e.preventDefault(); openDashboard(); });
    document.getElementById('closeDash').addEventListener('click', closeDashboard);
    document.getElementById('closeDash2').addEventListener('click', closeDashboard);
    dashOverlay.addEventListener('click', e=>{ if(e.target===dashOverlay) closeDashboard(); });
    document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeDashboard(); });

 document.getElementById('loginForm').addEventListener('submit', async e => {
  e.preventDefault();

  const email = document.getElementById('adminEmail').value.trim();
  const password = document.getElementById('adminPass').value;
  const errBox = document.getElementById('loginError');

  errBox.style.display = 'none';

  const { error } = await supabaseClient.auth.signInWithPassword({
    email,
    password
  });

  if (error) {
    console.error('Login error:', error);
    errBox.textContent = 'Email ou mot de passe incorrect.';
    errBox.style.display = 'block';
    return;
  }

  document.getElementById('loginForm').reset();
  setAuthed(true);
  showPanel();
});
document.getElementById('logoutBtn').addEventListener('click', async () => {
  stopAdminNotifications();
  setAuthed(false);
  const { error } = await supabaseClient.auth.signOut();

  if (error) {
    console.error('Logout error:', error);
    return;
  }

  closeDashboard();
});  

    document.querySelectorAll('.dash-tab').forEach(tab=>tab.addEventListener('click', ()=>{
      document.querySelectorAll('.dash-tab').forEach(t=>t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.dash-pane').forEach(p=> p.style.display = (p.dataset.pane===tab.dataset.tab) ? 'block' : 'none');
    }));

    /* ---------- (5) Gestion du menu (CRUD) ---------- */
    function populateCategorySelect(select){
      select.innerHTML = CATEGORIES.map(c=>`<option value="${c.value}">${escapeHtml(c.label)}</option>`).join('');
    }

    function renderDashboardMenu(){
      const items = loadMenu();
      const wrap = document.getElementById('dashMenuList');
      if(!items.length){
        wrap.innerHTML = '<div class="dash-empty">Aucun plat pour le moment. Ajoutez votre premier plat ci-dessus.</div>';
      } else {
        wrap.innerHTML = items.map(it => `
          <div class="dash-item">
            <div>
              <strong>${escapeHtml(it.name)}</strong> — <span style="color:var(--gold-2);font-weight:700">${it.price ? escapeHtml(it.price)+' DA' : 'Prix non défini'}</span>
              <div style="color:var(--muted);font-size:12px;margin-top:2px">${escapeHtml(catLabel(it.cat))}${it.available===false ? ' · Indisponible' : ''}</div>
              ${it.desc ? `<div style="font-size:13px;color:var(--muted);margin-top:4px">${escapeHtml(it.desc)}</div>` : ''}
            </div>
            <div class="dash-actions">
              <button type="button" title="Modifier" data-edit="${it.id}">✏️</button>
              <button type="button" title="Supprimer" data-del="${it.id}">🗑️</button>
            </div>
          </div>`).join('');
      }
      document.getElementById('statDishCount').textContent = items.length;
      document.getElementById('statCatCount').textContent = new Set(items.map(i=>i.cat)).size;
      document.getElementById('statAvailCount').textContent = items.filter(i=>i.available!==false).length;

      wrap.querySelectorAll('[data-edit]').forEach(b=>b.addEventListener('click', ()=>startEditDish(b.dataset.edit)));
      wrap.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click', ()=>deleteDish(b.dataset.del)));
    }

    function resetMenuForm(){
      document.getElementById('menuForm').reset();
      document.getElementById('menuItemId').value = '';
      document.getElementById('menuSubmitBtn').textContent = 'Ajouter au menu';
      document.getElementById('menuCancelEdit').style.display = 'none';
    }

    function startEditDish(id){
      const it = loadMenu().find(i=>i.id===id);
      if(!it) return;
      document.getElementById('menuItemId').value = it.id;
      document.getElementById('mName').value = it.name;
      document.getElementById('mPrice').value = it.price || '';
      document.getElementById('mCat').value = it.cat;
      document.getElementById('mAvail').value = it.available===false ? '0' : '1';
      document.getElementById('mDesc').value = it.desc || '';
      document.getElementById('menuSubmitBtn').textContent = 'Enregistrer les modifications';
      document.getElementById('menuCancelEdit').style.display = 'inline-flex';
      document.getElementById('menuForm').scrollIntoView({behavior:'smooth', block:'start'});
    }

    function deleteDish(id){
      if(!confirm('Supprimer ce plat du menu ?')) return;
      saveMenu(loadMenu().filter(i=>i.id!==id));
      renderDashboardMenu();
      renderMenu();
    }

    document.getElementById('menuForm').addEventListener('submit', e=>{
      e.preventDefault();
      const id = document.getElementById('menuItemId').value;
      const name = document.getElementById('mName').value.trim();
      const price = document.getElementById('mPrice').value.trim();
      const cat = document.getElementById('mCat').value;
      const available = document.getElementById('mAvail').value === '1';
      const desc = document.getElementById('mDesc').value.trim();
      if(!name) return;
      let items = loadMenu();
      if(id){ items = items.map(it => it.id===id ? {...it, name, price, cat, available, desc} : it); }
      else { items.push({id:'m_'+Date.now(), name, price, cat, available, desc}); }
      saveMenu(items);
      resetMenuForm();
      renderDashboardMenu();
      renderMenu();
      showToast('Menu mis à jour.');
    });
    document.getElementById('menuCancelEdit').addEventListener('click', resetMenuForm);


    /* ---------- Notifications Admin ---------- */
    const NOTIF_SEEN_KEY = 'vf_admin_seen_reservations';
    let notificationTimer = null;
    let notificationFirstLoad = true;
    let notificationKnownIds = new Set();

    function getSeenReservationIds(){
      try{
        const raw = localStorage.getItem(NOTIF_SEEN_KEY);
        return new Set(raw ? JSON.parse(raw) : []);
      }catch(e){ return new Set(); }
    }

    function saveSeenReservationIds(ids){
      try{ localStorage.setItem(NOTIF_SEEN_KEY, JSON.stringify([...ids].slice(-500))); }catch(e){}
    }

    function updateNotificationBadge(count){
      const badge = document.getElementById('notifCount');
      const btn = document.getElementById('notifBtn');
      if(!badge || !btn) return;
      badge.textContent = count > 99 ? '99+' : String(count);
      badge.classList.toggle('show', count > 0);
      btn.classList.toggle('has-new', count > 0);
    }

    function renderNotifications(items){
      const list = document.getElementById('notifList');
      if(!list) return;
      if(!items.length){
        list.innerHTML = '<div class="notif-empty">Aucune nouvelle réservation.</div>';
        return;
      }
      list.innerHTML = items.slice(0,20).map(r => `
        <div class="notif-item" data-notif-id="${escapeHtml(String(r.id))}">
          <strong>🔔 Nouvelle réservation — ${escapeHtml(r.name || 'Client')}</strong>
          <span>📅 ${escapeHtml(r.date || '—')} · 🕐 ${escapeHtml(r.time || '—')} · 👥 ${escapeHtml(String(r.people || '—'))}</span>
        </div>
      `).join('');

      list.querySelectorAll('[data-notif-id]').forEach(item=>{
        item.addEventListener('click', ()=>{
          const seen = getSeenReservationIds();
          seen.add(item.dataset.notifId);
          saveSeenReservationIds(seen);
          updateNotificationBadge(0);
          document.getElementById('notifMenu').classList.remove('show');
          document.querySelector('.dash-tab[data-tab="reservations"]')?.click();
          renderDashboardReservations();
        });
      });
    }

    async function checkNewReservations(showBrowserNotification = true){
      if(!isAuthed()) return;

      const { data: items, error } = await supabaseClient
        .from('reservations')
        .select('id,name,people,date,time,created_at,status')
        .order('created_at', { ascending:false })
        .limit(50);

      if(error){
        console.error('Notification check error:', error);
        return;
      }

      const seen = getSeenReservationIds();
      const fresh = (items || []).filter(r => r.id != null && !seen.has(String(r.id)));

      if(notificationFirstLoad){
        (items || []).forEach(r=>notificationKnownIds.add(String(r.id)));
        notificationFirstLoad = false;
        updateNotificationBadge(fresh.length);
        renderNotifications(fresh);
        return;
      }

      const trulyNew = fresh.filter(r => !notificationKnownIds.has(String(r.id)));
      (items || []).forEach(r=>notificationKnownIds.add(String(r.id)));

      updateNotificationBadge(fresh.length);
      renderNotifications(fresh);

      if(trulyNew.length && showBrowserNotification && 'Notification' in window && Notification.permission === 'granted'){
        trulyNew.slice(0,3).forEach(r=>{
          new Notification('Villa Frères — Nouvelle réservation', {
            body:`${r.name || 'Client'} · ${r.date || '—'} à ${r.time || '—'} · ${r.people || '—'} personne(s)`
          });
        });
      }
    }

    function startAdminNotifications(){
      if(notificationTimer) clearInterval(notificationTimer);
      notificationFirstLoad = false;
      notificationKnownIds = new Set();
      checkNewReservations(false);
      notificationTimer = setInterval(()=>checkNewReservations(true), 5000);
    }

    function stopAdminNotifications(){
      if(notificationTimer){
        clearInterval(notificationTimer);
        notificationTimer = null;
      }
    }

    document.getElementById('notifBtn').addEventListener('click', async ()=>{
      const menu = document.getElementById('notifMenu');
      menu.classList.toggle('show');
      if(menu.classList.contains('show')){
        const seen = getSeenReservationIds();
        const { data: items } = await supabaseClient
          .from('reservations')
          .select('id,name,people,date,time,created_at,status')
          .order('created_at', { ascending:false })
          .limit(50);
        const fresh = (items || []).filter(r=>r.id != null && !seen.has(String(r.id)));
        renderNotifications(fresh);
      }
    });

    document.addEventListener('click', e=>{
      const wrap = document.getElementById('notifWrap');
      if(wrap && !wrap.contains(e.target)){
        document.getElementById('notifMenu').classList.remove('show');
      }
    });

    async function requestNotificationPermission(){
      if(!('Notification' in window)) return;
      if(Notification.permission === 'default'){
        try{ await Notification.requestPermission(); }catch(e){}
      }
    }

    /* ---------- (6) Gestion des réservations (dashboard) ---------- */
    function statusLabel(s){ return s==='confirmed' ? 'Confirmée' : s==='cancelled' ? 'Annulée' : 'En attente'; }

async function renderDashboardReservations(){
  const wrap = document.getElementById('dashResList');

  wrap.innerHTML = '<div class="dash-empty">Chargement des réservations...</div>';

  const { data: items, error } = await supabaseClient
    .from('reservations')
    .select('*')
    .order('created_at', { ascending: false });

  if (error) {
    console.error('Supabase error:', error);
    wrap.innerHTML = '<div class="dash-empty">Impossible de charger les réservations.</div>';
    return;
  }

  if (!items || !items.length) {
    wrap.innerHTML = '<div class="dash-empty">Aucune réservation enregistrée.</div>';
    return;
  }

  wrap.innerHTML = items.map(r => `
    <div class="dash-item">
      <div>
        <strong>${escapeHtml(r.name || '—')}</strong>
        <span class="badge ${escapeHtml(r.status || 'pending')}">
          ${statusLabel(r.status || 'pending')}
        </span>

        <div style="font-size:13px;color:var(--muted);margin-top:4px">
          📅 ${escapeHtml(r.date || '—')}
          · 🕐 ${escapeHtml(r.time || '—')}
          · 👥 ${escapeHtml(String(r.people || '—'))}
          ${r.phone ? ` · ☎ <a href="tel:${escapeHtml(r.phone)}" style="color:var(--text)">${escapeHtml(r.phone)}</a>` : ''}
        </div>

        ${r.message ? `
          <div style="font-size:13px;color:var(--muted);margin-top:4px">
            💬 ${escapeHtml(r.message)}
          </div>
        ` : ''}
      </div>

      <div class="dash-actions" style="flex-direction:column;gap:6px">
        <button type="button" title="Confirmer" data-status="confirmed" data-id="${r.id}">✅</button>
        <button type="button" title="Annuler" data-status="cancelled" data-id="${r.id}">🚫</button>
        <button type="button" title="Supprimer" data-del-res="${r.id}">🗑️</button>
      </div>
    </div>
  `).join('');

  wrap.querySelectorAll('[data-status]').forEach(button => {
    button.addEventListener('click', async () => {
      const { error } = await supabaseClient
        .from('reservations')
        .update({ status: button.dataset.status })
        .eq('id', button.dataset.id);

      if (error) {
        console.error('Supabase error:', error);
        showToast('Erreur lors de la modification.');
        return;
      }

      renderDashboardReservations();
    });
  });

  wrap.querySelectorAll('[data-del-res]').forEach(button => {
    button.addEventListener('click', async () => {
      if (!confirm('Supprimer cette réservation ?')) return;

      const { error } = await supabaseClient
        .from('reservations')
        .delete()
        .eq('id', button.dataset.delRes);

      if (error) {
        console.error('Supabase error:', error);
        showToast('Erreur lors de la suppression.');
        return;
      }

      renderDashboardReservations();
    });
  });
}

    document.getElementById('addResManual').addEventListener('click', ()=>{
      const f = document.getElementById('manualResForm');
      f.style.display = f.style.display==='block' ? 'none' : 'block';
    });
    document.getElementById('mrCancel').addEventListener('click', ()=>{ document.getElementById('manualResForm').style.display='none'; });
    document.getElementById('mrSave').addEventListener('click', ()=>{
      const name = document.getElementById('mrName').value.trim();
      if(!name) return;
      const r = {
        id:'r_'+Date.now(), name,
        phone: document.getElementById('mrPhone').value.trim(),
        people: document.getElementById('mrPeople').value,
        date: document.getElementById('mrDate').value,
        time: document.getElementById('mrTime').value,
        message: document.getElementById('mrNote').value.trim(),
        status:'pending', createdAt:Date.now()
      };
      const list = loadReservations(); list.unshift(r); saveReservations(list);
      document.getElementById('manualResForm').style.display='none';
      ['mrName','mrPhone','mrDate','mrTime','mrNote'].forEach(id=>document.getElementById(id).value='');
      document.getElementById('mrPeople').value='2';
      renderDashboardReservations();
    });

    function csvEscape(v){ const s = String(v==null?'':v); return /[;"\n]/.test(s) ? '"'+s.replace(/"/g,'""')+'"' : s; }
    function exportReservationsCSV(){
      const items = loadReservations();
      const header = ['Nom','Téléphone','Personnes','Date','Heure','Message','Statut','Créée le'];
      const rows = items.map(r => [r.name, r.phone, r.people, r.date, r.time, (r.message||'').replace(/\n/g,' '), statusLabel(r.status), new Date(r.createdAt).toLocaleString('fr-FR')]);
      const csv = [header, ...rows].map(row=>row.map(csvEscape).join(';')).join('\n');
      const blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8;'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `reservations_${new Date().toISOString().slice(0,10)}.csv`;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
    }
    document.getElementById('exportCsv').addEventListener('click', exportReservationsCSV);

    /* ---------- Paramètres : mot de passe & réinitialisation du menu ---------- */
    document.getElementById('passForm').addEventListener('submit', e=>{
      e.preventDefault();
      const val = document.getElementById('newPass').value;
      if(val.length < 4) return;
      localStorage.setItem(PASS_KEY, val);
      document.getElementById('newPass').value = '';
      const ok = document.getElementById('passSaved');
      ok.style.display = 'block';
      setTimeout(()=>ok.style.display='none', 2500);
    });
    document.getElementById('resetMenuBtn').addEventListener('click', ()=>{
      if(!confirm('Réinitialiser le menu avec les plats par défaut ? Cette action supprimera vos plats actuels.')) return;
      saveMenu(JSON.parse(JSON.stringify(DEFAULT_MENU)));
      renderDashboardMenu();
      renderMenu();
    });

    /* ---------- (7) Initialisation ---------- */
    document.getElementById('year').textContent = new Date().getFullYear();
    const dateInput = document.getElementById('date');
    if(dateInput) dateInput.min = new Date().toISOString().slice(0,10);
    populateCategorySelect(document.getElementById('mCat'));
    renderFilters();
    renderMenu();
  </script>
</body>
</html>
