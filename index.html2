        <button class="dash-tab" data-tab="reservations" type="button">Réservations</button>
        <button class="dash-tab" data-tab="settings" type="button">Paramètres</button>
      </div>
      <div class="dash-body">

        <div class="dash-pane" data-pane="menu">
          <div class="stats" style="grid-template-columns:repeat(3,1fr);margin-top:0;margin-bottom:18px">
            <div class="stat"><strong id="statDishCount">0</strong><span>plats au menu</span></div>
            <div class="stat"><strong id="statCatCount">0</strong><span>catégories utilisées</span></div>
            <div class="stat"><strong id="statAvailCount">0</strong><span>disponibles</span></div>
          </div>
          <form id="menuForm">
